# NirmanVaani (निर्माणवाणी) Environment Configuration Template
# Copy this file to .env and configure values for your deployment.
# Note: .env is gitignored to protect secrets from being committed.

# Policymaker Master Secret Key
# Used for hackathon demo evaluation & emergency admin access.
# Defaults to 'demo-passcode' for local evaluation if unset.
POLICYMAKER_SECRET_KEY=demo-passcode

# Google Gemini API Key (Optional)
# If omitted, NirmanVaani automatically activates its offline heuristic structuring engine.
# GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Optional, comma-separated)
# ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://nirmanvaani.onrender.com
